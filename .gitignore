# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: real secrets stay ignored; only safe templates are committed
.env
.env.local
.env.staging
.env.production
.env.test
.env.*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma


# Python virtual environments
embedding-service/.venv/
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo

# FastAPI local files
embedding-service/.pytest_cache/
embedding-service/.mypy_cache/
embedding-service/.ruff_cache/
/docs

