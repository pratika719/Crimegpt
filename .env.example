# =============================================================================
# CrimeGPT — Environment Variable Reference (.env.example)
# -----------------------------------------------------------------------------
# Copy this file to create per-environment files:
#   Development (local):  copy to `.env` (loaded by Next.js / dotenv / prisma)
#   Staging / Production: set the SAME variables in the platform dashboards
#                         (Vercel scopes, Render services, Neon, Redis Cloud)
#
# NEVER commit real secrets. Real values live only in:
#   - `.env`                     (local, gitignored)
#   - Vercel project settings    (Development / Preview / Production scopes)
#   - Render / GitHub Actions    (staging + production services)
#
# Conventions:
#   NODE_ENV = build behavior      (development | test | production)
#   APP_ENV  = config selector     (development | staging | production)
#   Staging runs NODE_ENV=production with staging resources.
# =============================================================================

# ---- Environment selector ---------------------------------------------------
APP_ENV=development
NODE_ENV=development

# ---- Core infrastructure (per environment) ----------------------------------
# Dev:    postgresql://crimegpt:crimegpt@localhost:5434/crimegpt?schema=public  (docker compose)
# Staging: Neon branch/database URL for staging
# Prod:    Neon main database URL
DATABASE_URL=

# Dev:    redis://localhost:6381  (docker compose)
# Staging/Prod: Redis Cloud / Render Redis URL (rediss:// for TLS)
REDIS_URL=
# Optional explicit TLS Redis URL (used as fallback by the BullMQ connection)
REDIS_TLS_URL=

# ---- Authentication ----------------------------------------------------------
# A shared JWT/encryption secret. Generate per environment:
#   openssl rand -base64 32
AUTH_SECRET=
# Canonical public URL of the web app for this environment
AUTH_URL=
NEXT_PUBLIC_APP_URL=
# Google OAuth — create a SEPARATE OAuth client per environment
# (each has its own authorized redirect URI, e.g.
#  http://localhost:3000/api/auth/callback  for dev)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- AI providers ------------------------------------------------------------
GEMINI_API_KEY=
# Model used by the Gemini provider (optional, defaults inside code)
GEMINI_MODEL=

# Optional legacy routing vars (currently unused by src/; kept for compat)
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=gemini
ENABLE_AI_FALLBACK=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_REQUEST_TIMEOUT_MS=60000

# ---- Embedding service (FastAPI + sentence-transformers) ---------------------
# Dev:    http://localhost:8000  (run locally: uvicorn main:app --port 8000)
# Staging/Prod: hosted URL (e.g. Render service or cloud embedding API)
EMBEDDING_PROVIDER=fastapi
EMBEDDING_SERVICE_URL=
EMBEDDING_REQUEST_TIMEOUT_MS=90000

# ---- Observability -----------------------------------------------------------
# Required in production (deep health check gate)
HEALTHCHECK_SECRET=
SERVICE_NAME=crimegpt-app        # worker overrides to crimegpt-worker
LOG_LEVEL=info                   # debug | info | warn | error
PINO_PRETTY=true                 # set false for JSON logs in production
# Worker health endpoint (used by warmup/health checks)
WORKER_HEALTH_URL=
# Worker health listener port (defaults to 10000)
PORT=

# ---- Background job concurrency (worker process) -----------------------------
DOCUMENT_GENERATION_CONCURRENCY=1
EMBEDDING_CONCURRENCY=2
INGESTION_CONCURRENCY=1
EMAIL_CONCURRENCY=2
CLEANUP_CONCURRENCY=1
# Disable document-generation auto-repair retry: set to "false"
DOCGEN_REPAIR_RETRY=

# ---- AI limits & tuning ------------------------------------------------------
AI_DOCUMENT_DAILY_LIMIT=5
AI_REGENERATE_DAILY_LIMIT=2
LAW_RETRIEVAL_TOP_K=4
AI_MAX_CONTEXT_CHARS=50000
AI_MAX_OUTPUT_TOKENS=4000
AI_USE_LEGAL_RETRIEVAL=true
AI_USE_EMBEDDINGS=true
AI_USE_FALLBACK=true
AI_USE_CACHE=true
