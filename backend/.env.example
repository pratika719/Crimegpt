# CrimeGPT Backend — Environment Variables

# Database
DATABASE_URL=postgresql://crimegpt:crimegpt@localhost:5434/crimegpt?schema=public

# Redis
REDIS_URL=redis://localhost:6381

# Auth
AUTH_SECRET=your-auth-secret-here
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth callback URL — where Google redirects after consent (must match Google Console setting)
GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback

# Frontend URL — where users are redirected after login
FRONTEND_URL=http://localhost:3000

# AI
GEMINI_API_KEY=your-gemini-api-key

# Embedding Service (FastAPI sidecar)
EMBEDDING_SERVICE_URL=http://localhost:8000
EMBEDDING_PROVIDER=fastapi

# App
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
SERVICE_NAME=crimegpt-backend
LOG_LEVEL=debug

# Health
HEALTHCHECK_SECRET=local-health-secret
