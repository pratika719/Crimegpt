# ==============================================================================
# CrimeGPT Production Environment Configuration (.env.production)
# ==============================================================================

# 1. Domain & SSL (Used by Caddy for automatic Let's Encrypt HTTPS)
DOMAIN=crimegpt.me
ACME_EMAIL=your-email@example.com

# 2. Database (PostgreSQL + pgvector)
POSTGRES_USER=crimegpt
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=crimegpt

# 3. Security & Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=generate_a_random_32_byte_secret_here

# 4. Google OAuth (From Google Cloud Console: Credentials -> OAuth 2.0 Client IDs)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://crimegpt.me/api/auth/google/callback

# 5. AI Services
GEMINI_API_KEY=your-gemini-api-key

# 6. CORS Configuration
CORS_ORIGIN=https://crimegpt.me
LOG_LEVEL=info
